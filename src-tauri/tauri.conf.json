{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nerevar",
  "version": "0.2.0",
  "identifier": "dev.kyleaustad.nerevar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nerevar",
        "width": 1400,
        "height": 1000,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Victor Persson",
    "homepage": "https://github.com/loragea/nerevar-rs",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) Nerevar contributors. Licensed under the GNU GPL v3.0.",
    "category": "Game",
    "shortDescription": "Morrowind Multiplayer without the mod-list headaches.",
    "longDescription": "Nerevar keeps a TES3MP host and its players synchronized on mods, load order, and game data. Point it at your Morrowind installation, join a server, and it downloads the exact mod set and load order the host runs, installs the TES3MP build the host asks for, and launches the game. Server owners get instance management, a sync server, and co-admin mod management. Nerevar never distributes Morrowind game data.",
    "linux": {
      "deb": {
        "section": "games",
        "priority": "optional",
        "desktopTemplate": "../packaging/linux/nerevar.desktop",
        "files": {
          "/usr/share/doc/nerevar/copyright": "../packaging/debian/copyright"
        }
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "depends": ["webkit2gtk4.1", "gtk3"],
        "desktopTemplate": "../packaging/linux/nerevar.desktop",
        "files": {
          "/usr/share/licenses/nerevar/LICENSE": "../LICENSE"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
